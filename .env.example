# Copy to .env.dev (committed defaults) or .env (local overrides, git-ignored)
APP_ENV=dev
LOG_LEVEL=debug

# Postgres (single instance locally, schema per service)
DATABASE_URL=postgres://acme:acme@localhost:55432/acmecard?sslmode=disable

# Gateway
GATEWAY_HTTP_ADDR=:8080
JWT_HS256_SECRET=dev-only-change-me-32-bytes-minimum!!
IDEMPOTENCY_TTL=24h
RATE_LIMIT_PER_MINUTE=60

# Bank webhook (simulated settlement)
BANK_WEBHOOK_SECRET=bank-dev-secret
BANK_WEBHOOK_TOLERANCE=5m

# Card network (simulated) HMAC secret
NETWORK_WEBHOOK_SECRET=network-dev-secret

# Internal gRPC
ACCOUNTS_GRPC_ADDR=localhost:9001
LEDGER_GRPC_ADDR=localhost:9002
BILLING_GRPC_ADDR=localhost:9004

# Billing (Sprint 4): APR in basis points (2280 = 1.9% monthly), per-currency floor/late fee, statements bucket
BILLING_APR_BPS=2280
BILLING_FIXED_AMOUNTS=USD:2500,EUR:2500,MXN:45000,COP:10000000
STATEMENTS_BUCKET=acme-card-statements-dev
# Simulated account clock route at the gateway (dev only)
DEV_CLOCK_ENABLED=1

# Close and payouts (Sprint 5): base64 32-byte key encrypting payout destinations (KMS in AWS).
# Dev-only key; never reuse outside local development.
DESTINATION_KEY=ZGV2LW9ubHktZGVzdGluYXRpb24ta2V5LTMyYnl0ZXM=
# Payment return window (120h; only APP_ENV=dev may shorten it, for load tests)
RETURN_WINDOW=120h

# Audit (Sprint 6): Ed25519 private key (base64, 64 bytes) signing checkpoints and archive manifests.
# Dev-only key; KMS asymmetric key in AWS.
AUDIT_SIGNING_KEY=Yx+PUKd7Jjh4NEsXWMfphQHluU3QJDF0/BngwVb/hIfSg3+t7p07lnydJzPAR8foraRjOXqRuCYG1R02LEfOmA==
AUDIT_GRPC_ADDR=localhost:9005

# AWS / LocalStack
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:acme-card-events
AUDIT_SQS_QUEUE_URL=http://localhost:4566/000000000000/acme-card-audit

# Host port for the load balancer in front of the gateway replicas
GATEWAY_PORT=8088

# Host port for the Next.js flow simulator
WEB_PORT=3010

# Host port for the project Postgres (5432 is often taken by a local install)
POSTGRES_PORT=55432
