# Copy to .env.dev (committed defaults) or .env (local overrides, git-ignored)
APP_ENV=dev
LOG_LEVEL=debug

# Postgres (single instance locally, schema per service)
DATABASE_URL=postgres://acme:acme@localhost:55432/acmecard?sslmode=disable

# Gateway
GATEWAY_HTTP_ADDR=:8080
JWT_HS256_SECRET=dev-only-change-me-32-bytes-minimum!!
IDEMPOTENCY_TTL=24h
RATE_LIMIT_PER_MINUTE=60

# Bank webhook (simulated settlement)
BANK_WEBHOOK_SECRET=bank-dev-secret
BANK_WEBHOOK_TOLERANCE=5m

# Internal gRPC
ACCOUNTS_GRPC_ADDR=localhost:9001
LEDGER_GRPC_ADDR=localhost:9002

# AWS / LocalStack
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:acme-card-events
AUDIT_SQS_QUEUE_URL=http://localhost:4566/000000000000/acme-card-audit

# Host port for the load balancer in front of the gateway replicas
GATEWAY_PORT=8088

# Host port for the Next.js flow simulator
WEB_PORT=3010

# Host port for the project Postgres (5432 is often taken by a local install)
POSTGRES_PORT=55432
